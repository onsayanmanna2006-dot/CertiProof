# ==============================================================================
# CertiProof - Midnight Network Configuration (Preview / Preprod)
# ==============================================================================

# Target network: "preview" or "preprod"
MIDNIGHT_NETWORK=preview

# Network endpoints
INDEXER_URI=https://indexer.preview.midnight.network/api/v1/graphql
NODE_URI=https://rpc.preview.midnight.network
PROOF_SERVER_URI=http://127.0.0.1:6300

# Wallet Configuration (Never commit your actual seed phrase to git!)
# Generate a seed or use the Midnight Lace Wallet testnet account
WALLET_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Optional: Deployed Contract Address (populated after running deployment)
# MIDNIGHT_CONTRACT_ADDRESS=
