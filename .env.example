# ==============================================================================
# CertiProof - Midnight Network Configuration (Preview / Preprod)
# ==============================================================================

# Target network: "preview" or "preprod"
MIDNIGHT_NETWORK=preview

# Network endpoints (defaults below match the selected network; override only
# if you're running a local standalone node/indexer instead of testnet)
INDEXER_URI=https://indexer.preview.midnight.network/api/v3/graphql
INDEXER_WS_URI=wss://indexer.preview.midnight.network/api/v3/graphql/ws
NODE_URI=https://rpc.preview.midnight.network
PROOF_SERVER_URI=http://127.0.0.1:6300

# Wallet Configuration (NEVER commit your actual seed to git!)
# 32-byte hex-encoded wallet seed (64 hex characters), NOT a 12-word phrase.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then fund the printed unshielded address from the faucet before deploying:
#   Preview:  https://faucet.preview.midnight.network
#   Preprod:  https://faucet.preprod.midnight.network
WALLET_SEED_HEX=

# Optional: demo certificate data used by scripts/deploy.ts to exercise the
# deployed contract once after deployment. All defaults are non-sensitive.
DEMO_STUDENT_ID=STUDENT_001_ALICE
DEMO_SUBJECT_ID=CS_101_ALGORITHMS
DEMO_MARKS=78
DEMO_SALT=random_entropy_salt_49821

# Optional: Deployed Contract Address (populated after running deployment)
# MIDNIGHT_CONTRACT_ADDRESS=
